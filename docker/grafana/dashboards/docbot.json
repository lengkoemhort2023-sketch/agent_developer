              { "id": "unit", "value": "watt" },
              { "id": "color", "value": { "fixedColor": "#FF9830", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "Temp.*" },
            "properties": [
              { "id": "unit", "value": "celsius" },
